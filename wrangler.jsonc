{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flowbase",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-19",
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "compatibility_flags": ["nodejs_compat"],
  // The one Cron Trigger (FLOW-27): each run processes a small batch of due jobs.
  "triggers": { "crons": ["*/5 * * * *"] },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  // No top-level Hyperdrive binding: plain `wrangler dev` and CI run without a
  // database and report "not_configured". Bindings are per environment.
  "env": {
    // Dev database. Use: npx wrangler dev --remote --env dev (see README, Database).
    "dev": {
      "hyperdrive": [
        { "binding": "HYPERDRIVE", "id": "925a83ae72554fdd8e25e630cc7060d8" },
      ],
      "vars": { "DB_CHECK_ROUTE": "enabled" },
    },
    // Production database. Workers Builds deploys it from main (npm run deploy).
    "production": {
      "name": "flowbase",
      "hyperdrive": [
        { "binding": "HYPERDRIVE", "id": "d6486e8ab1314d8ca1dbf5addf1036d0" },
      ],
      // File storage (FLOW-42): the Worker signs short-lived R2 URLs with the
      // R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY Worker secrets, and uses the FILES
      // binding only to confirm uploads. Other environments have no file storage,
      // so their attachment routes answer 503.
      "vars": {
        "R2_ACCOUNT_ID": "198f242b0d80d010bf3ba7a2b2b351c2",
        "R2_BUCKET": "flowbase-files",
      },
      "r2_buckets": [{ "binding": "FILES", "bucket_name": "flowbase-files" }],
    },
    // Preview versions of the flowbase Worker for non-production branches
    // (npm run deploy:preview). Same Worker name, dev database.
    "preview": {
      "name": "flowbase",
      "hyperdrive": [
        { "binding": "HYPERDRIVE", "id": "925a83ae72554fdd8e25e630cc7060d8" },
      ],
    },
  },
}
