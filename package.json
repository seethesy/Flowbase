{
  "name": "flowbase",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && tsc --project tsconfig.worker.json --noEmit && vite build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "dev:worker": "wrangler dev",
    "typecheck:worker": "tsc --project tsconfig.worker.json --noEmit",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "test:db": "vitest run --config vitest.db.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "node scripts/seed.mjs",
    "db:check": "node scripts/check-migration-drift.mjs",
    "deploy": "npm run build && npm run deploy:migrate && wrangler deploy --env production",
    "deploy:migrate": "node scripts/require-env.mjs DATABASE_URL && drizzle-kit migrate"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@fontsource/inter": "^5.2.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.3",
    "@sentry/cloudflare": "^11.8.0",
    "@sentry/react": "^11.8.0",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-table": "^8.21.0",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-list": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.17",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "jose": "^6.2.13",
    "lucide-react": "^0.468.0",
    "postgres": "^3.4.9",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.9.0",
    "recharts": "^3.0.0",
    "tailwind-merge": "^3.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261019.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/vite": "^4.1.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.72.1",
    "vite": "^7.1.0",
    "vitest": "^5.0.4",
    "wrangler": "^4.151.2"
  },
  "engines": {
    "node": "22.23.4"
  }
}
