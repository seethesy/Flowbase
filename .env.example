# All VITE_* values are public build-time browser configuration.
VITE_SENTRY_DSN=
# Worker configuration: use ignored .dev.vars locally and Cloudflare secrets remotely.
SENTRY_DSN=
# Optional release override. Defaults to package.json version.
APP_VERSION=
# CI only: disposable Postgres service; no production credentials in Actions.
DATABASE_URL=postgres://flowbase:flowbase@localhost:5432/flowbase_ci
# Hyperdrive binding HYPERDRIVE is declared per environment in wrangler.jsonc.
# Local `wrangler dev --env dev` (no --remote) needs a connection string; set it in
# your shell or .dev.vars, never here:
# CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=
# drizzle-kit migrate reads DATABASE_URL; for the dev database use your own shell value.
# Do not substitute a production database URL into this file.
