# Cloudflare static assets headers (FLOW-325). The service worker and the app
# page are always revalidated, so a deploy is found on the next check; hashed
# build files never change and cache for a year.
/sw.js
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/
  Cache-Control: no-cache
/assets/*
  Cache-Control: public, max-age=31536000, immutable
